{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      // =========================== Catalog Service ==========================
      "catalogsReadRoute": {
        "ClusterId": "catalogsCluster",
        "Match": {
          "Path": "/catalogs/{**catchall}",
          "Methods": [ "GET", "HEAD" ]
        },
        "Transforms": [
          { "PathPattern": "/api/catalogs/{**catchall}" }
        ]
      },
      "catalogsWriteRoute": {
        "ClusterId": "catalogsCluster",
        //"AuthorizationPolicy": "default", // Added for security on write
        "Match": {
          "Path": "/catalogs/{**catchall}",
          "Methods": [ "POST", "PUT", "DELETE", "PATCH" ]
        },
        "Transforms": [
          { "PathPattern": "/api/catalogs/{**catchall}" }
        ]
      },

      // ========================= ORDERS SERVICE =========================
      "ordersReadRoute": {
        "ClusterId": "ordersCluster",
        "Match": {
          "Path": "/orders/{**catchall}",
          "Methods": [ "GET", "HEAD" ]
        },
        "Transforms": [
          { "PathPattern": "/api/orders/{**catchall}" }
        ]
      },
      "ordersWriteRoute": {
        "ClusterId": "ordersCluster",
        //"AuthorizationPolicy": "default", // Added for security on write
        "Match": {
          "Path": "/orders/{**catchall}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        },
        "Transforms": [
          { "PathPattern": "/api/orders/{**catchall}" }
        ]
      },
      "keysWriteRoute": {
        "ClusterId": "ordersCluster",
        "Match": {
          "Path": "/keys/{**catchall}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        },
        "Transforms": [
          { "PathPattern": "/api/keys/{**catchall}" }
        ]
      },
      "bundlePayloadsReadRoute": {
        "ClusterId": "ordersCluster",
        "Match": {
          "Path": "/bundle-payloads/{**catchall}",
          "Methods": [ "GET", "HEAD" ]
        },
        "Transforms": [
          { "PathPattern": "/api/bundle-payloads/{**catchall}" }
        ]
      },
      "bundlePayloadsWriteRoute": {
        "ClusterId": "ordersCluster",
        "Match": {
          "Path": "/bundle-payloads/{**catchall}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        },
        "Transforms": [
          { "PathPattern": "/api/bundle-payloads/{**catchall}" }
        ]
      },

      // ========================= BASKETS SERVICE =========================
      "basketsReadRoute": {
        "ClusterId": "basketsCluster",
        "Match": {
          "Path": "/baskets/{**catchall}",
          "Methods": [ "GET", "HEAD" ]
        },
        "Transforms": [
          { "PathPattern": "/api/baskets/{**catchall}" }
        ]
      },
      "basketsWriteRoute": {
        "ClusterId": "basketsCluster",
        //"AuthorizationPolicy": "default", // Added for security on write
        "Match": {
          "Path": "/baskets/{**catchall}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        },
        "Transforms": [
          { "PathPattern": "/api/baskets/{**catchall}" }
        ]
      },

      // ========================= NOTIFICATIONS SERVICE =========================
      "notificationsReadRoute": {
        "ClusterId": "notificationsCluster",
        "Match": {
          "Path": "/notifications/{**catchall}",
          "Methods": [ "GET", "HEAD" ]
        },
        "Transforms": [
          { "PathPattern": "/api/notifications/{**catchall}" }
        ]
      },
      "notificationsWriteRoute": {
        "ClusterId": "notificationsCluster",
        //"AuthorizationPolicy": "default", // Added for security on write
        "Match": {
          "Path": "/notifications/{**catchall}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        },
        "Transforms": [
          { "PathPattern": "/api/notifications/{**catchall}" }
        ]
      },

      // =========================== Payment Service ==========================
      "paymentsReadRoute": {
        "ClusterId": "paymentsCluster",
        "Match": {
          "Path": "/payments/{**catchall}",
          "Methods": [ "GET", "HEAD" ]
        },
        "Transforms": [
          { "PathPattern": "/api/payments/{**catchall}" }
        ]
      },
      "paymentsWriteRoute": {
        "ClusterId": "paymentsCluster",
        //"AuthorizationPolicy": "default", // Added for security on write
        "Match": {
          "Path": "/payments/{**catchall}",
          "Methods": [ "POST", "PUT", "DELETE", "PATCH" ]
        },
        "Transforms": [
          { "PathPattern": "/api/payments/{**catchall}" }
        ]
      },
      // ============================ Bundle Service ============================
      "bundlesReadRoute": {
        "ClusterId": "bundlesCluster",
        "Match": {
          "Path": "/bundles/{**catchall}",
          "Methods": [ "GET", "HEAD" ]
        },
        "Transforms": [
          { "PathPattern": "/api/bundles/{**catchall}" }
        ]
      },
      "bundlesWriteRoute": {
        "ClusterId": "bundlesCluster",
        "MaxRequestBodySize": 2147483648,
        //"AuthorizationPolicy": "default", // Added for security on write
        "Match": {
          "Path": "/bundles/{**catchall}",
          "Methods": [ "POST", "PUT", "DELETE", "PATCH" ]
